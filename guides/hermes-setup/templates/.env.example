# Variable names only. No working credentials. Do not overwrite a real .env.
# Prefer `hermes -p operator setup` and `hermes -p operator gateway setup`.
# Configure only the provider and tools you actually use.
# OPENROUTER_API_KEY=REPLACE_LOCALLY
# ANTHROPIC_API_KEY=REPLACE_LOCALLY
# OPENAI_API_KEY=REPLACE_LOCALLY
# TELEGRAM_BOT_TOKEN=REPLACE_LOCALLY
# TELEGRAM_ALLOWED_USERS=YOUR_NUMERIC_TELEGRAM_USER_ID
# TELEGRAM_HOME_CHANNEL=YOUR_NUMERIC_CHAT_ID
# OAuth providers use their supported login flow; do not copy someone else's auth.json.
